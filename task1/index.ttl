@prefix : <http://example.org/university#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://example.org/university#> .

[ rdf:type owl:Ontology
 ] .

#################################################################
#    Object Properties
#################################################################

###  http://example.org/university#enrolledIn
:enrolledIn rdf:type owl:ObjectProperty ;
            rdfs:domain :Student ;
            rdfs:range :Course .


###  http://example.org/university#teaches
:teaches rdf:type owl:ObjectProperty ;
         rdfs:domain :Professor ;
         rdfs:range :Course .


#################################################################
#    Classes
#################################################################

###  http://example.org/university#Course
:Course rdf:type owl:Class .


###  http://example.org/university#Professor
:Professor rdf:type owl:Class .


###  http://example.org/university#Student
:Student rdf:type owl:Class .


#################################################################
#    Individuals
#################################################################

###  http://example.org/university#Alice
:Alice rdf:type owl:NamedIndividual ,
                :Student ;
       :enrolledIn :Math101 .


###  http://example.org/university#Bob
:Bob rdf:type owl:NamedIndividual ,
              :Student ;
     :enrolledIn :CS101 .


###  http://example.org/university#CS101
:CS101 rdf:type owl:NamedIndividual ,
                :Course .


###  http://example.org/university#DrSmith
:DrSmith rdf:type owl:NamedIndividual ,
                  :Professor ;
         :teaches :CS101 .


###  http://example.org/university#Math101
:Math101 rdf:type owl:NamedIndividual ,
                  :Course .


