@prefix : <http://example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://example.org/ontology#> .

[ rdf:type owl:Ontology
 ] .

#################################################################
#    Annotation properties
#################################################################

###  http://www.w3.org/2002/07/owl#functionalProperty
owl:functionalProperty rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2002/07/owl#irreflexiveProperty
owl:irreflexiveProperty rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2002/07/owl#transitiveProperty
owl:transitiveProperty rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://example.org/ontology#hasAncestor
:hasAncestor rdf:type owl:ObjectProperty ;
             owl:inverseOf :hasDescendant ;
             rdfs:domain :Person ;
             rdfs:range :Person ;
             owl:propertyChainAxiom ( :hasParent
                                    ) ,
                                    ( :hasParent
                                      :hasAncestor
                                    ) ;
             owl:transitiveProperty "true"^^xsd:boolean .


###  http://example.org/ontology#hasChild
:hasChild rdf:type owl:ObjectProperty ;
          owl:inverseOf :hasParent ;
          rdfs:domain :Person ;
          rdfs:range :Person .


###  http://example.org/ontology#hasDescendant
:hasDescendant rdf:type owl:ObjectProperty ;
               rdfs:domain :Person ;
               rdfs:range :Person ;
               owl:transitiveProperty "true"^^xsd:boolean .


###  http://example.org/ontology#hasParent
:hasParent rdf:type owl:ObjectProperty ;
           rdfs:domain :Person ;
           rdfs:range :Person ;
           owl:functionalProperty "true"^^xsd:boolean ;
           owl:irreflexiveProperty "true"^^xsd:boolean .


#################################################################
#    Classes
#################################################################

###  http://example.org/ontology#Person
:Person rdf:type owl:Class .


